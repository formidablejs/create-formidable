{
    "name": "create-formidable",
    "version": "0.0.13",
    "description": "The Formidable Framework Installer",
    "author": "Donald Pakkies @donaldp",
    "bin": {
        "create-formidable": "./bin/run.js"
    },
    "homepage": "https://github.com/formidablejs/create-formidable",
    "license": "MIT",
    "main": "dist/index.js",
    "repository": "formidablejs/create-formidable",
    "files": [
        "./bin",
        "./dist",
        "./oclif.manifest.json"
    ],
    "dependencies": {
        "@formidablejs/installer": "^0.9.13",
        "@inquirer/prompts": "^7.4.1",
        "@oclif/core": "^4",
        "@oclif/plugin-help": "^6",
        "@oclif/plugin-plugins": "^5"
    },
    "devDependencies": {
        "@eslint/compat": "^1",
        "@oclif/prettier-config": "^0.2.1",
        "@oclif/test": "^4",
        "@types/chai": "^4",
        "@types/mocha": "^10",
        "@types/node": "^18",
        "chai": "^4",
        "eslint": "^9",
        "eslint-config-oclif": "^6",
        "eslint-config-prettier": "^10",
        "mocha": "^10",
        "oclif": "^4",
        "shx": "^0.3.3",
        "ts-node": "^10",
        "typescript": "^5"
    },
    "oclif": {
        "bin": "create-formidable",
        "dirname": "create-formidable",
        "commands": {
            "strategy": "single",
            "target": "./dist/index.js"
        },
        "plugins": [
            "@oclif/plugin-help",
            "@oclif/plugin-plugins"
        ],
        "topicSeparator": " "
    },
    "scripts": {
        "build": "shx rm -rf dist && tsc -b",
        "lint": "eslint",
        "postpack": "shx rm -f oclif.manifest.json",
        "posttest": "npm run lint",
        "prepack": "oclif manifest && oclif readme",
        "test": "mocha --forbid-only \"test/**/*.test.ts\"",
        "version": "oclif readme && git add README.md"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "bugs": "https://github.com/formidablejs/create-formidable/issues",
    "keywords": [
        "formidable",
        "full-stack"
    ],
    "types": "dist/index.d.ts"
}
